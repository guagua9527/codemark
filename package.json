{
  "name": "codemark",
  "private": true,
  "scripts": {
    "dev": "concurrently \"PROJECT_ROOT=./examples/vue-app pnpm --filter @codemark/server dev\" \"pnpm --filter vue-app dev\"",
    "dev:server": "pnpm --filter @codemark/server dev",
    "dev:app": "pnpm --filter vue-app dev",
    "build:frontend": "pnpm --filter @codemark/frontend build",
    "build:plugin": "pnpm --filter @codemark/vite-plugin build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
