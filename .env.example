# DeepSeek API Key (required for AI fix feature)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom model name (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# Optional: Custom API base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: Server port (default: 3001)
# CODEMARK_PORT=3001
